# =========================================================================
#   DOCKER COMPOSE ENVIRONMENT (orchestration-level config)
#   Copy to `.env` in this same directory. App secrets still live in
#   backend/.env (copy backend/.env.example there first) — this file only
#   controls how the containers are wired together.
# =========================================================================

# --- Postgres ---
POSTGRES_USER=dundu
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dundu_db
POSTGRES_PORT=5432

# --- Host ports ---
BACKEND_PORT=5000
WEB_PORT=3000
ADMIN_PORT=3001

# --- CORS: public origins the frontends are served from (used by the
#     backend for its Access-Control-Allow-Origin allowlist) ---
WEB_CLIENT_URL=http://localhost:3000
ADMIN_CLIENT_URL=http://localhost:3001
SUPER_ADMIN_CLIENT_URL=

# --- Build-time frontend env vars (baked into the static build) ---
# Leave the *_VITE_API_BASE_URL vars empty so each frontend calls its own
# nginx on relative /api and /uploads paths, which proxy to the backend
# container — this avoids CORS entirely for same-origin deployments.
WEB_VITE_API_BASE_URL=
ADMIN_VITE_API_BASE_URL=
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
VITE_SUPPORT_WHATSAPP=91XXXXXXXXXX
