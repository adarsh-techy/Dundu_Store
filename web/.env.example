# =========================================================================
#                    DUNDU WEB FRONTEND ENVIRONMENT VARIABLES (TEMPLATE)
# =========================================================================

# -------------------------------------------------------------------------
# 1. API & BACKEND CONFIGURATION
# -------------------------------------------------------------------------
# Note: In Vite, all client-side variables must start with VITE_ prefix.

# --- LOCAL DEVELOPMENT API BASE URL ---
VITE_API_BASE_URL=

# --- PRODUCTION / HOSTING API BASE URL ---
# VITE_API_BASE_URL=https://<your-backend-domain>.com

# -------------------------------------------------------------------------
# 2. THIRD-PARTY API INTEGRATIONS
# -------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
VITE_SUPPORT_WHATSAPP=91XXXXXXXXXX
