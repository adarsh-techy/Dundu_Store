# =========================================================================
#                    DUNDU ADMIN DASHBOARD ENVIRONMENT VARIABLES
# =========================================================================

# -------------------------------------------------------------------------
# 1. API CONNECTION CONFIGURATION
# -------------------------------------------------------------------------
# Note: In Vite, all client-side variables must start with VITE_ prefix.

# --- LOCAL DEVELOPMENT API BASE URL ---
# (points to your local backend server. Vite proxy redirects /api to this target in vite.config.js)
VITE_API_BASE_URL=http://localhost:5000

# --- PRODUCTION / HOSTING API BASE URL ---
# (Comment out the local dev URL and uncomment this to connect to your hosted API domain)
# VITE_API_BASE_URL=https://<your-backend-domain>.com



# superadmin@velora.com
# admin@123
