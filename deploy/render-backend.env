# ── Render → dundu-api → Environment → "Add from .env" → paste this whole block ──
# Replace every <...> value. Lines you don't have yet can stay empty; those features fall back to mock mode.

NODE_ENV=production
PORT=5000
TRUST_PROXY=1
JWT_EXPIRES_IN=7d

# run on your Mac:  openssl rand -hex 48   → paste the output
JWT_SECRET=<paste-64-plus-random-characters>

# Render → dundu-db → Connections → "Internal Database URL"
DATABASE_URL=<postgresql://dundu:PASSWORD@dpg-xxxx-a/dundu>

# Exact Vercel URLs — https://, no trailing slash (update after Vercel deploy)
WEB_CLIENT_URL=https://dundu-web-demo.vercel.app
ADMIN_CLIENT_URL=https://dundu-store.vercel.app

# Google sign-in (console.cloud.google.com → Credentials → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://dundu-backend-demo.onrender.com/api/auth/google/callback

# Razorpay (Settings → API Keys). Test keys first, live keys after KYC.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Twilio (Console → Account SID / Auth Token). Sandbox number below; replace with your approved WhatsApp sender later.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Cloudinary (Dashboard). REQUIRED on Render — otherwise uploaded images vanish on every deploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Uploads (only used when Cloudinary is not configured)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
