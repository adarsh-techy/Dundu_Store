# =========================================================================
#                    DUNDU MOBILE APP ENVIRONMENT VARIABLES (TEMPLATE)
# =========================================================================

# -------------------------------------------------------------------------
# 1. API CONNECTION CONFIGURATION
# -------------------------------------------------------------------------
# Note: In Expo, all environment variables must start with EXPO_PUBLIC_ prefix.

# --- LOCAL DEVELOPMENT API CONFIGURATION ---
EXPO_PUBLIC_API_URL=http://<your-machine-local-ip>:5000/api
EXPO_PUBLIC_UPLOADS_URL=http://<your-machine-local-ip>:5000

# --- PRODUCTION / HOSTING API CONFIGURATION ---
# EXPO_PUBLIC_API_URL=https://<your-backend-domain>.com/api
# EXPO_PUBLIC_UPLOADS_URL=https://<your-backend-domain>.com
