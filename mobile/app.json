{
  "expo": {
    "name": "Dundu",
    "slug": "dundu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Delivery staff use the camera to scan hub pickup QR codes."
      },
      "bundleIdentifier": "com.dundu.store",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.dundu.store",
      "versionCode": 1,
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Delivery staff use the camera to scan hub pickup QR codes."
        }
      ]
    ],
    "scheme": "dundu"
  }
}